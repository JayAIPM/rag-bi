# 数据库连接信息
MONGODB_URI=mongodb://admin:admin304%40pzj@localhost:27017/rag-services?authSource=admin&authMechanism=DEFAULT


# 服务器配置
PORT=3000
HOST=localhost

# JWT 配置
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=24h

# 文件存储配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# 模型配置
OLLAMA_URL=http://localhost:11434
LLM_MODEL=deepseek-r1:8b
EMBEDDING_MODEL=nomic-embed-text
LLM_TIMEOUT=60000
CHUNK_TIMEOUT=30000
MAX_ANSWER_LENGTH=5000

# 查询重写配置
QUERY_REWRITE_MODEL=deepseek-r1:8b
QUERY_REWRITE_TIMEOUT=30000
QUERY_REWRITE_ENABLED=true

# 重排序配置
RERANK_MODEL=bge-reranker-v2-m3
RERANK_TIMEOUT=30000
RERANK_TOP_K=10
RERANK_CANDIDATE_COUNT=10
RERANK_ENABLED=true

# 安全配置
CORS_ORIGIN=*
NODE_ENV=development

# 日志配置
LOG_LEVEL=info

# 向量数据库配置
LANCE_DB_PATH=./lancedb
